# ============================================================================
# TradePilot Arena — Environment Configuration
# Copy to .env :  cp .env.example .env
# ============================================================================

# --- Security ---------------------------------------------------------------
# Used to encrypt provider API keys at rest in local mode. CHANGE THIS.
APP_SECRET_KEY=change-me-please-use-a-long-random-string
# Local login password (username is always "admin").
LOCAL_ADMIN_PASSWORD=tradepilot

# --- Infrastructure ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tradepilot:tradepilot@postgres:5432/tradepilot
REDIS_URL=redis://redis:6379/0

# --- AI Provider API keys (ALL OPTIONAL — demo mode works without them) -----
# NOTE: a "Cloud API key" is interpreted as an Anthropic Claude API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Trading safety switches ------------------------------------------------
# Keep live trading OFF. This first version is paper-trading only.
LIVE_TRADING_ENABLED=false
PAPER_TRADING=true
# Demo mode: synthetic market data + mock LLMs so the app runs with no keys.
DEMO_MODE=true

# --- UI defaults ------------------------------------------------------------
DEFAULT_LANGUAGE=zh-CN
DEFAULT_THEME=system

# --- Cost control -----------------------------------------------------------
# Monthly AI spend budget (USD). Agents auto-pause when exceeded.
MONTHLY_AI_BUDGET_USD=50

# --- Agent runner -----------------------------------------------------------
# Decision interval in seconds during market hours.
DECISION_INTERVAL_SECONDS=300

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
